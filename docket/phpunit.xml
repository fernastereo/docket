<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:hERCo4CheoG8+Dh7sQrG8UTXqtYRQqqHfdBDhWwkLI8="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Argon2id con costo mínimo: en producción usa los valores por defecto (64 MiB). -->
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- Tests SIEMPRE contra PostgreSQL real y una base exclusiva (docket_test).
             force="true" es imprescindible: sin él, el DB_DATABASE del entorno (el
             contenedor app trae docket_central) gana sobre este archivo y
             DatabaseMigrations haría migrate:fresh sobre la base central.
             Host, usuario y clave sí vienen del entorno (contenedor, CI o tu shell). -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="docket_test" force="true"/>
        <!-- Laravel lee primero de $_SERVER, y PHPUnit no lo pisa con <env>: sin
             estas dos líneas el DB_DATABASE del contenedor sigue ganando. -->
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="docket_test" force="true"/>
        <!-- Mismo motivo para lo que cambia el comportamiento de los tests: sin
             APP_ENV=testing Laravel no desactiva la verificación CSRF en tests, y
             con CACHE_STORE/SESSION_DRIVER/QUEUE_CONNECTION del contenedor
             (database, redis…) el rate limiter y la sesión persistirían entre
             tests y entre corridas. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="DB_URL" value=""/>
        <!-- Correo y enlaces de las pruebas no dependen del entorno: con el
             MAIL_MAILER=smtp de un local.env los tests intentarían enviar correo
             real, y con PLATFORM_TENANT_URL_PORT los enlaces saldrían con puerto.
             Va también como <server> por la misma razón que DB_DATABASE. -->
        <!-- Los mensajes que ve la gente salen en español: los tests no dependen del
             APP_LOCALE del entorno (el CI no lo define, el local.env sí). -->
        <env name="APP_LOCALE" value="es" force="true"/>
        <server name="APP_LOCALE" value="es" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="PLATFORM_TENANT_URL_PORT" value="" force="true"/>
        <server name="PLATFORM_TENANT_URL_PORT" value="" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
