APP_NAME=CuraduriAPP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
APP_TIMEZONE=America/Bogota

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Multi-tenancy (stancl/tenancy, ADR-002). Coma-separados; ver config/tenancy.php.
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1

# Central: catálogo de tenants + identidades (ADR-005). Las bases de cada
# tenant las crea/gestiona stancl/tenancy en el mismo servidor.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=docket_central
DB_USERNAME=docket
DB_PASSWORD=
DB_SSLMODE=prefer

# Sanctum SPA (mismo origen, cookie httpOnly + CSRF — amendment de ADR-003).
# Admite wildcard: p. ej. *.staging.curaduria.app,staging.curaduria.app
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# SESSION_DOMAIN se deja SIN definir a propósito: cada subdominio de tenant
# tiene su propia cookie, nunca compartida entre curadurías (ADR-005/ADR-017).
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@curaduria.app"
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=

# Archivos (DO Spaces / MinIO, ADR-007). Ver infra/env/*.env.example por ambiente.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# IA (ADR-004) — vacío hasta elegir proveedor.
LLM_PROVIDER=null
LLM_API_KEY=

SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
