# Brevo (https://app.brevo.com) — captura de leads de la landing
# API key: Brevo > Settings > SMTP & API > API Keys > Generate a new API key
BREVO_API_KEY=

# Lista de contactos de Brevo donde se guardan los leads de esta landing
# Brevo > Contacts > Lists > (crear una lista "CuraduriAPP - Landing") > copiar su ID numérico
BREVO_LIST_ID=

# Atributos de contacto usados en Brevo (Contacts > Settings > Contact
# attributes), tipo texto: NOMBRE_CURADURIAPP, CURADURIA_CURADURIAPP,
# CARGO_CURADURIAPP, CIUDAD_CURADURIAPP.
# El email se guarda como identificador del contacto, no como atributo.
