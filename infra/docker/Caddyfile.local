# Caddy · entorno LOCAL (tu Mac o cualquier PC, docker-compose.local.yml)
#
# *.docket.test no es un dominio público resoluble, así que Caddy emite certs
# con su propia CA interna automáticamente (sin ACME, sin token de Cloudflare).
# El navegador va a marcar el cert como no confiable la primera vez — normal en
# local; instrucciones para confiar en la CA en infra/README.md.
#
# Requiere entradas en /etc/hosts, ej.:
#   127.0.0.1  docket.test central.docket.test tenant1.docket.test

{
	admin off
	# Docker mapea 8080/8443 (host) -> 80/443 (contenedor, donde Caddy sigue
	# escuchando de verdad — eso no cambia). `http_port`/`https_port` NO sirve
	# acá: en esta versión de Caddy mueve el bind real, y entonces deja de
	# coincidir con el mapeo de Docker. En su lugar: apagamos el redirect
	# automático (que asume puertos estándar y genera "https://docket.test/"
	# sin :8443 — nada escucha ahí desde afuera) y escribimos uno explícito
	# con el puerto externo correcto.
	auto_https disable_redirects
	servers {
		trusted_proxies static private_ranges
	}
}

http://*.docket.test, http://docket.test {
	redir https://{host}:8443{uri} 308
}

*.docket.test, docket.test {
	tls internal

	root * /var/www/html/public
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	php_fastcgi app:9000
	file_server

	log {
		output stdout
		format json
	}
}
