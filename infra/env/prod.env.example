# CuraduriAPP · entorno PROD — plantilla.
#
# Copiá a  infra/env/prod.env  en el droplet docket-prod y completá. Real:
# cifrado con SOPS+age (ADR-017), nunca en el repo en claro.

# ------------------------------------------------------------------ imágenes (las publica CI en ghcr.io)
APP_IMAGE=ghcr.io/OWNER/docket-app
CADDY_IMAGE=ghcr.io/OWNER/docket-caddy
IMAGE_TAG=latest
ORIGIN_CERT_DIR=/opt/docket/origin        # contiene cert.pem y key.pem (Origin CA de Cloudflare)

# ------------------------------------------------------------------ app
APP_NAME=CuraduriAPP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://curaduria.app
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
TENANCY_CENTRAL_DOMAINS=curaduria.app,www.curaduria.app

# ------------------------------------------------------------------ base de datos (DO Managed PG)
DB_CONNECTION=pgsql
DB_HOST=                                   # host privado del cluster docket-prod-db
DB_PORT=25060
DB_DATABASE=docket_central
DB_USERNAME=                               # usuario de app dedicado (no doadmin)
DB_PASSWORD=
DB_SSLMODE=require                         # Managed PG exige SSL
DB_SSLROOTCERT=/opt/docket/pg-ca.crt       # CA descargada del panel de DO

# ------------------------------------------------------------------ redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------ archivos (Spaces prod)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=docket-prod-files
AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------ mensajería (Brevo)
MAIL_MAILER=smtp
BREVO_API_KEY=

# ------------------------------------------------------------------ IA (ADR-004)
LLM_PROVIDER=
LLM_API_KEY=

# ------------------------------------------------------------------ observabilidad
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SENTRY_LARAVEL_DSN=
