# CuraduriAPP · entorno LOCAL (tu Mac o cualquier PC) — plantilla.
#
# Copiá a  infra/env/local.env  (gitignoreado) y completá. Nunca se sube al
# repo ni se comparte por chat — cada dev tiene el suyo.

# ------------------------------------------------------------------ app
APP_NAME=CuraduriAPP
APP_ENV=local
APP_KEY=                                   # php artisan key:generate --show
APP_DEBUG=true
APP_URL=https://docket.test
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

# Multi-tenancy (stancl/tenancy) — dominio central en local
TENANCY_CENTRAL_DOMAINS=docket.test,central.docket.test

# ------------------------------------------------------------------ base de datos (contenedor local)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=docket_central
DB_USERNAME=docket
DB_PASSWORD=                                # inventá una para tu máquina
DB_SSLMODE=prefer

# ------------------------------------------------------------------ redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------ archivos
# Opción A (recomendada, sin setup extra): usar el bucket real de dev — es una
# API HTTPS normal, se puede pegar desde cualquier máquina con internet.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=DO801Z87HMCFRED8EDZ7
AWS_SECRET_ACCESS_KEY=                      # secret de la key docket-dev-app
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=docket-dev-files
AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Opción B (100% offline): comentar lo de arriba y usar MinIO en un contenedor
# local — pedime que te lo agregue al compose si preferís esto.

# ------------------------------------------------------------------ mensajería / IA — apagado en local
MAIL_MAILER=log
BREVO_API_KEY=
LLM_PROVIDER=null
LLM_API_KEY=

# ------------------------------------------------------------------ observabilidad
LOG_CHANNEL=stderr
LOG_LEVEL=debug
SENTRY_LARAVEL_DSN=
