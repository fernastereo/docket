# CuraduriAPP · entorno DEV — plantilla.
#
# Copiá a  infra/env/dev.env  y completá los secretos. El archivo real está
# gitignoreado; en el droplet se gestiona cifrado con SOPS+age (ADR-017).
# Este mismo archivo lo consume docker-compose (env_file) y Laravel (.env).

# ------------------------------------------------------------------ app
APP_NAME=CuraduriAPP
APP_ENV=local
APP_KEY=                                   # php artisan key:generate --show
APP_DEBUG=true
APP_URL=https://staging.curaduria.app
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

# Multi-tenancy (stancl/tenancy) — dominio(s) central(es) en dev
TENANCY_CENTRAL_DOMAINS=staging.curaduria.app

# ------------------------------------------------------------------ infra (Caddy)
ACME_EMAIL=fernando.cueto@markenfilm-space.de
CLOUDFLARE_API_TOKEN=                       # token Zone.DNS:Edit de curaduria.app

# ------------------------------------------------------------------ base de datos
# Central. Los tenants los crea stancl/tenancy en el mismo servidor (contenedor `db`).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=docket_central
DB_USERNAME=docket
DB_PASSWORD=                                # inventá una para dev
DB_SSLMODE=prefer

# ------------------------------------------------------------------ redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------ archivos (Spaces)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=DO801Z87HMCFRED8EDZ7
AWS_SECRET_ACCESS_KEY=                      # secret de la key docket-dev-app
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=docket-dev-files
AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------ mensajería (Brevo, ADR-008)
MAIL_MAILER=log                            # en dev, a log hasta configurar Brevo
BREVO_API_KEY=

# ------------------------------------------------------------------ IA (ADR-004) — vacío por ahora
LLM_PROVIDER=null
LLM_API_KEY=

# ------------------------------------------------------------------ observabilidad
LOG_CHANNEL=stderr
LOG_LEVEL=debug
SENTRY_LARAVEL_DSN=
